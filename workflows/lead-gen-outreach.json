    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet places = [];\nfor (const item of items) {\n  if (Array.isArray(item.json)) {\n    places = places.concat(item.json);\n  } else {\n    places.push(item.json);\n  }\n}\n\nfunction firstOf(arr) {\n  return (Array.isArray(arr) && arr.length && arr[0]) ? arr[0] : null;\n}\n\n// Rejects placeholder / non-deliverable scrape artifacts that pass a bare presence check\n// (e.g. email@gmail.com, test@example.com, sentry/wix tracking addresses).\n// Generic-but-real business inboxes (info@, support@, admin@, sales@) are KEPT.\nfunction isUsableEmail(e) {\n  if (!e || e === '—') return 'no';\n  const addr = String(e).trim().toLowerCase();\n  if (!/^[^@\\s]+@[^@\\s]+\\.[a-z]{2,}$/.test(addr)) return 'no';\n  const parts = addr.split('@');\n  const local = parts[0];\n  const domain = parts[1];\n  const badLocals = ['email','e-mail','mail','test','testing','example','sample','user','username','name','yourname','youremail','your-email','your.email','none','na','abc','asdf','xxx','xxxx','firstname','lastname'];\n  if (badLocals.indexOf(local) !== -1) return 'no';\n  if (/^(no-?reply|do-?not-?reply|donotreply)/.test(local)) return 'no';\n  const badDomains = ['example.com','example.org','example.net','domain.com','yourdomain.com','test.com','email.com','mydomain.com','sentry.io','sentry-next.wixpress.com','wixpress.com'];\n  if (badDomains.indexOf(domain) !== -1) return 'no';\n  return 'yes';\n}\n\nfunction onlineEstimates(p) {\n  const info = p.additionalInfo;\n  if (!info || typeof info !== 'object') return '—';\n  for (const key of Object.keys(info)) {\n    const arr = info[key];\n    if (!Array.isArray(arr)) continue;\n    for (const entry of arr) {\n      if (entry && typeof entry === 'object' && Object.prototype.hasOwnProperty.call(entry, 'Online estimates')) {\n        const v = entry['Online estimates'];\n        return v === true ? 'yes' : v === false ? 'no' : '—';\n      }\n    }\n  }\n  return '—';\n}\n\nconst results = [];\nfor (const p of places) {\n  const email =\n    p.email ||\n    (Array.isArray(p.emails) && p.emails[0]) ||\n    (p.contactDetails && Array.isArray(p.contactDetails.emails) && p.contactDetails.emails[0]) ||\n    '—';\n\n  const socialsList = [\n    firstOf(p.linkedIns),\n    firstOf(p.instagrams),\n    firstOf(p.facebooks),\n    firstOf(p.youtubes),\n    firstOf(p.tiktoks),\n  ].filter(Boolean);\n\n  results.push({\n    json: {\n      name: p.title || p.name || '—',\n      website: p.website || '—',\n      email: email,\n      emailValid: isUsableEmail(email),\n      phone: p.phone || p.phoneUnformatted || '—',\n      address: p.address || '—',\n      city: p.city || '—',\n      category: p.categoryName || p.category || '—',\n      rating: p.totalScore ?? '—',\n      reviews: p.reviewsCount ?? '—',\n      mapsUrl: p.url || '—',\n      placeId: p.placeId || '—',\n      onlineEstimates: onlineEstimates(p),\n      description: p.description || '—',\n      socials: socialsList.length ? socialsList.join(' ; ') : '—',\n      isAdvertisement: p.isAdvertisement === true ? 'yes' : (p.isAdvertisement === false ? 'no' : '—'),\n      imagesCount: (typeof p.imagesCount === 'number') ? p.imagesCount : '—',\n      listingClaimed: p.claimThisBusiness === false ? 'yes' : (p.claimThisBusiness === true ? 'no' : '—'),\n    }\n  });\n}\nreturn results;\n"
      },
